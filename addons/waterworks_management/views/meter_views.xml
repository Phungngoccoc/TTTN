<odoo>
    <!-- Tree view cho Đồng hồ nước -->
    <record id="view_water_meter_tree" model="ir.ui.view">
        <field name="name">water.meter.tree</field>
        <field name="model">water.meter</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="customer_id" />
                <field name="type" />
                <field name="status" />
            </tree>
        </field>
    </record>

    <!-- Form view cho Đồng hồ nước -->
    <record id="view_water_meter_form" model="ir.ui.view">
        <field name="name">water.meter.form</field>
        <field name="model">water.meter</field>
        <field name="arch" type="xml">
            <form string="Đồng hồ nước">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="customer_id" />
                        <field name="type" />
                        <field name="status" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kanban view cho Đồng hồ nước -->
    <record id="view_water_meter_kanban" model="ir.ui.view">
        <field name="name">water.meter.kanban</field>
        <field name="model">water.meter</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name" />
                <field name="customer_id" />
                <field name="type" />
                <field name="status" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_content">
                            <strong>
                                <field name="name" />
                            </strong>
                            <div>
                                <field name="customer_id" />
                            </div>
                            <div>
                                <field name="type" />
                            </div>
                            <div>
                                <field name="status" />
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action cho Đồng hồ nước, hiển thị mặc định Tree View -->
    <record id="action_dong_ho" model="ir.actions.act_window">
        <field name="name">Đồng hồ nước</field>
        <field name="res_model">water.meter</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="view_id" ref="view_water_meter_tree" />
    </record>

    <!-- Menu con cho Đồng hồ nước -->
    <menuitem id="menu_dong_ho" name="Đồng hồ nước"
        parent="menu_cap_nuoc_root"
        action="action_dong_ho" />
</odoo>