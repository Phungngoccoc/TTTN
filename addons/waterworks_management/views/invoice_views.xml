<odoo>
    <!-- Tree view cho Hóa đơn nước -->
    <record id="view_water_invoice_tree" model="ir.ui.view">
        <field name="name">water.invoice.tree</field>
        <field name="model">water.invoice</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="customer_id" />
                <field name="date" />
                <field name="amount" />
                <field name="state" />
            </tree>
        </field>
    </record>

    <!-- Form view cho Hóa đơn nước -->
    <record id="view_water_invoice_form" model="ir.ui.view">
        <field name="name">water.invoice.form</field>
        <field name="model">water.invoice</field>
        <field name="arch" type="xml">
            <form string="Hóa đơn nước">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="customer_id" />
                        <field name="date" />
                        <field name="amount" />
                        <field name="state" />
                    </group>
                    <group>
                        <!-- Trường Binary cho phép người dùng tải ảnh lên -->
                        <field name="image" options="{'no_edit': True}" widget="binary"
                            filename="image_name" />
                    </group>
                    <button name="action_send_invoice"
                        type="object"
                        string="Gửi hóa đơn"
                        class="btn-primary" />
                    <button name="action_read_index"
                        type="object"
                        string="Đọc chỉ số bằng ảnh"
                        class="btn-primary ms-3" />
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kanban view cho Hóa đơn nước -->
    <record id="view_water_invoice_kanban" model="ir.ui.view">
        <field name="name">water.invoice.kanban</field>
        <field name="model">water.invoice</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="name" />
                <field name="customer_id" />
                <field name="amount" />
                <field name="state" />
                <field name="date" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_content">
                            <strong>
                                <field name="name" />
                            </strong>
                            <div>
                                <field name="customer_id" />
                            </div>
                            <div>Số tiền: <field name="amount" /></div>
                            <div>Ngày: <field name="date" /></div>
                            <div>Trạng thái: <field name="state" /></div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action cho Hóa đơn nước, hiển thị mặc định Tree View -->
    <record id="action_hoa_don_nuoc" model="ir.actions.act_window">
        <field name="name">Hóa đơn nước</field>
        <field name="res_model">water.invoice</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="view_id" ref="view_water_invoice_tree" />
    </record>

    <!-- Menu con trong Cấp nước -->
    <menuitem id="menu_hoa_don_nuoc" name="Hóa đơn nước"
        parent="menu_cap_nuoc_root"
        action="action_hoa_don_nuoc" />
</odoo>